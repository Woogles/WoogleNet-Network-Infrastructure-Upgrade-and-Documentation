# ==============================================================================
# WOOGLENET GLOBAL INFRASTRUCTURE CONFIGURATION
# Last Updated: 2026-10-09
# ==============================================================================

# --- 1. NETWORK IDENTITY ---
DOMAIN_NAME=home.arpa
TIMEZONE=America/New_York
# Primary DNS (JAX)
DNS_SERVER_IP=10.0.10.5 
# Secondary DNS (MAX or PAX) - Added for redundancy
DNS_SECONDARY_IP=REPLACE_WITH_SECONDARY_ADGUARD_IP

# --- 2. VLAN SEGMENTATION (UDM-Pro & TP-Link Alignment) ---
# Note: VLAN 1 is reserved as a "Dead VLAN" for security
VLAN_NATIVE=1
VLAN_MGMT=REPLACE_WITH_MGMT_VLAN_ID
VLAN_TRUSTED=10
VLAN_IOT=30
VLAN_GUEST=40

# --- 3. STORAGE ARCHITECTURE (Proxmox NAS) ---
# The IP of your NAS VM/Container on Proxmox
NAS_IP=10.0.10.10
# The absolute path where NAS is mounted on the Ubuntu host
NAS_BASE_PATH=/mnt/wooglenet_nas/appdata

# --- 4. POWER MANAGEMENT (NUT - Network UPS Tools) ---
# The IP of the privileged LXC acting as the NUT Master
NUT_MASTER_IP=REPLACE_WITH_NUT_LXC_IP
# List of UPS IDs defined in ups.conf (comma separated)
NUT_UPS_LIST=ups-core,ups-gpu,ups-network
# Shutdown trigger threshold (percentage)
NUT_SHUTDOWN_THRESHOLD=20

# --- 5. HOST IDENTIFICATION & NETWORK MAP ---
# Set this to the specific host this file is sitting on (JAX, SAX, DAX, MAX, or PAX)
CURRENT_HOST=JAX

# Host IP Mapping for internal routing/automation
IP_JAX=10.0.2.10
IP_SAX=10.0.2.11
IP_DAX=REPLACE_WITH_DAX_IP
IP_MAX=REPLACE_WITH_MAX_IP
IP_PAX=REPLACE_WITH_PAX_IP

# --- 6. EXTERNAL ACCESS STRATEGY ---
# Primary VPN for Admin
TAILSCALE_NETWORK=tailscale.com
# Tunnel ID for public web services
CLOUDFLARE_TUNNEL_ID=REPLACE_WITH_TUNNEL_ID
# Public port for Plex (UDM-Pro Forward)
PLEX_EXTERNAL_PORT=32400

# --- 7. CORE SERVICE IPs (Nginx Proxy Manager Targets) ---
IP_PROXY_MANAGER=10.0.10.6
IP_VAULTWARDEN=10.0.10.7
IP_NEXTCLOUD=10.0.10.8
IP_IMMICH=10.0.10.9
IP_HOMEPAGE=10.0.10.10

# --- 8. GLOBAL DOCKER SETTINGS ---
DOCKER_NETWORK_NAME=wooglenet_core

# --- 9. SAX (GPU Node) SPECIFICS ---
# Maintained as Bare Metal due to 3-slot GPU physical constraints
SAX_LAN_IP=10.0.2.11
SAX_TAILSCALE_IP=REPLACE_WITH_SAX_TAILSCALE_IP
GPU_3060_ID=REPLACE_WITH_NVIDIA_SMI_UUID
GPU_1070_ID=REPLACE_WITH_NVIDIA_SMI_UUID
