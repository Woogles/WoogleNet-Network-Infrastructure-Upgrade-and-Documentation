# ==============================================================================
# WOOGLENET GLOBAL INFRASTRUCTURE CONFIGURATION
# Based on WoogleNet Git Documentation
# ==============================================================================

# --- 1. NETWORK IDENTITY ---
# The local domain for your non-technical users (DNS Rewrites)
DOMAIN_NAME=home.arpa
TIMEZONE=America/New_York
# The IP of the AdGuard instance (usually on JAX)
DNS_SERVER_IP=10.0.10.5 

# --- 2. VLAN SEGMENTATION (UDM-Pro Alignment) ---
# Defined in README as the core security boundaries
VLAN_TRUSTED=10
VLAN_IOT=30
VLAN_GUEST=40

# --- 3. STORAGE ARCHITECTURE (Proxmox NAS) ---
# The IP of your NAS VM/Container on Proxmox
NAS_IP=10.0.10.10
# The absolute path where NAS is mounted on the Ubuntu host
# This is the "Root" that all other app paths stem from
NAS_BASE_PATH=/mnt/wooglenet_nas/appdata

# --- 4. HOST IDENTIFICATION ---
# Set this to the specific host this file is sitting on (JAX, SAX, DAX, MAX, or PAX)
CURRENT_HOST=JAX

# --- 5. CORE SERVICE IPs ---
# These are used by the AI to configure Nginx Proxy Manager (NPM)
# Mapping: [Service] = [IP]
IP_PROXY_MANAGER=10.0.10.6
IP_VAULTWARDEN=10.0.10.7
IP_NEXTCLOUD=10.0.10.8
IP_IMMICH=10.0.10.9
IP_HOMEPAGE=10.0.10.10

# --- 6. GLOBAL DOCKER SETTINGS ---
# Ensures all WoogleNet containers can talk to each other regardless of host
DOCKER_NETWORK_NAME=wooglenet_core

# --- Global Docker Settings ---
DOCKER_NETWORK_NAME=wooglenet_core

# --- #SAX Information ---
SAX_LAN_IP=10.0.2.11
SAX_TAILSCALE_IP=REPLACE_WITH_SAX_TAILSCALE_IP
GPU_3060_ID=REPLACE_WITH_NVIDIA_SMI_UUID
GPU_1070_ID=REPLACE_WITH_NVIDIA_SMI_UUID

# --- Foundations network settings: ---
SERVER_LAN_IP=10.0.2.10
TZ=Etc/UTC
